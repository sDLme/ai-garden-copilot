{
  "name": "ai-garden-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native garden copilot portfolio project.",
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx apps/api/src/server.ts",
    "dev:web": "ng serve web",
    "build": "tsc -b apps/api && ng build web",
    "build:api": "tsc -b apps/api",
    "build:web": "ng build web",
    "build:pages": "node scripts/build-github-pages.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.0"
  }
}
